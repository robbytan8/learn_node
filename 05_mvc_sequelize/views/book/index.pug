extends ../layouts/master

block content
  .content-wrapper
    // Content Header
    section.content-header
      .container-fluid
        .row.mb-2
          .col-sm-6
            h1 Dashboard
    // Main content
    section.content
      .container-fluid
        .card
          .card-header
            h3.card-title Book List
            a.btn.btn-primary.btn-sm.float-right(href='/book/create') Create New Book
          .card-body
            table.table.table-bordered
              thead
                tr
                  th(scope='col') ISBN
                  th(scope='col') Title
                  th(scope='col') Author
                  th(scope='col') Publish Year
                  th(scope='col') Category
                  th(scope='col') Action
              tbody
                each book in books
                  tr
                    td= book.isbn
                    td= book.title
                    td= book.author
                    td= book.publish_year
                    td= book.category_id ? book.category.name : 'Uncategorized'
                    td
                      a.btn.btn-warning.btn-sm(href=`/book/${book.isbn}/edit`) Edit
                      form(method='POST', action=`/book/${book.isbn}?_method=DELETE`, style='display:inline', onsubmit='return confirm("Are you sure you want to delete this book?");')
                        button.btn.btn-danger.btn-sm(type='submit') Delete